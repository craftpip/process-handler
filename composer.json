{
  "name": "craftpip/process-handler",
  "type": "library",
  "description": "Get list of running processes by name or pid, supports windows and unix",
  "keywords": [
    "process",
    "pid exists",
    "process exists",
    "running processes"
  ],
  "homepage": "https://github.com/craftpip/process-handler",
  "license": "MIT",
  "authors": [
    {
      "name": "Boniface Pereira",
      "email": "hey@craftpip.com"
    }
  ],
  "require": {
    "php": ">=7.2",
    "symfony/process": "^4.4|^5.4|^6.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^1.12",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Craftpip\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Craftpip\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix"
  }
}
